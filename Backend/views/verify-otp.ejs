<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Verify Email</title>

  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #f5f5f5;
      font-family: Arial, sans-serif;
    }

    .otp-box {
      width: 90%;
      max-width: 380px;
      padding: 30px;
      background: white;
      border-radius: 12px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.1);
      text-align: center;
    }

    input {
      width: 100%;
      box-sizing: border-box;
      padding: 13px;
      margin: 15px 0;
      font-size: 20px;
      letter-spacing: 8px;
      text-align: center;
    }

    button {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 6px;
      background: #f5ba13;
      font-size: 16px;
      cursor: pointer;
    }

    .resend-button {
      margin-top: 10px;
      background: transparent;
      color: #333;
      border: 1px solid #ccc;
    }

    .error {
      color: red;
    }
  </style>
</head>

<body>
  <div class="otp-box">
    <h2>Verify your email</h2>

    <p>
      We sent a 6-digit OTP to
      <strong><%= email %></strong>
    </p>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <form action="/verify-otp" method="POST">
      <input
        type="text"
        name="otp"
        inputmode="numeric"
        pattern="[0-9]{6}"
        maxlength="6"
        placeholder="000000"
        autocomplete="one-time-code"
        required
      >

      <button type="submit">Verify OTP</button>
    </form>

    <form action="/resend-otp" method="POST">
      <button class="resend-button" type="submit">
        Resend OTP
      </button>
    </form>
  </div>
</body>
</html>
